# Copy to backend/.env (gitignored). Real environment variables override these.

# Supabase → Connect → Direct → Session pooler. Split the URI into JDBC URL + user + password:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>

# Supabase project URL (no trailing slash); used to verify auth tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# Where the React app runs (CORS).
FRONTEND_ORIGIN=http://localhost:5173
